# ── Streamlit Dashboard — Cloud Run ──────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install \
        streamlit streamlit-folium folium \
        requests httpx certifi python-dotenv

# ── Runtime ──────────────────────────────────────────────────────────────────
FROM python:3.11-slim
WORKDIR /app
COPY --from=builder /install /usr/local

COPY dashboard/ dashboard/
COPY pipeline/__init__.py pipeline/__init__.py
COPY pipeline/config.py   pipeline/config.py
COPY docker-entrypoint-dashboard.sh /entrypoint.sh

# Make entrypoint executable
RUN chmod +x /entrypoint.sh

# Streamlit config: disable telemetry, enable headless mode for Cloud Run
# Written with printf to avoid Docker heredoc parser misreading [section] headers.
RUN mkdir -p .streamlit && printf \
    '[server]\nheadless = true\nenableCORS = false\nenableXsrfProtection = true\n\n[browser]\ngatherUsageStats = false\n' \
    > .streamlit/config.toml

ENV PORT=8501
EXPOSE ${PORT}

# Use custom entrypoint that injects SEO tags into Streamlit's index.html at startup
# (Requires root to modify /usr/local/lib files; Cloud Run is already sandboxed)
ENTRYPOINT ["/entrypoint.sh"]
