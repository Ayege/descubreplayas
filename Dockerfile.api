# ── FastAPI API — Cloud Run ───────────────────────────────────────────────────
# Lean two-stage build. The API only needs FastAPI, supabase-py, httpx and
# python-telegram-bot — no Earth Engine, Copernicus, or Streamlit.
FROM python:3.11-slim AS builder

WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install \
        fastapi "uvicorn[standard]" pydantic \
        supabase python-dotenv httpx certifi \
        python-telegram-bot

# ── Runtime ──────────────────────────────────────────────────────────────────
FROM python:3.11-slim
WORKDIR /app
COPY --from=builder /install /usr/local
COPY api/       api/
COPY pipeline/__init__.py pipeline/__init__.py
COPY pipeline/config.py   pipeline/config.py

# Cloud Run injects $PORT at runtime; fall back to 8000 locally
ENV PORT=8000
EXPOSE ${PORT}

RUN useradd -m appuser
USER appuser

CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT} --workers 2"]
