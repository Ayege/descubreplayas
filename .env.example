# Google Earth Engine
EE_PROJECT=                 # Google Cloud project id with Earth Engine enabled
EE_SERVICE_ACCOUNT_JSON=    # path to service-account key OR the JSON string

# Copernicus Marine (CMEMS)
CMEMS_USERNAME=
CMEMS_PASSWORD=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=               # service role key for the pipeline; anon key for read API

# Telegram
TELEGRAM_BOT_TOKEN=
# Shared secret to authenticate Telegram webhook calls (any random string).
# Register the webhook with this value so spoofed updates are rejected.
TELEGRAM_WEBHOOK_SECRET=

# Deployment
API_BASE_URL=               # public Render URL, used by dashboard + webhook registration

# Analytics
GA_MEASUREMENT_ID=          # Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX (leave blank to disable)

# SEO / social sharing
APP_CANONICAL_URL=          # canonical URL of the Streamlit dashboard, e.g. https://descubreplayas.com.do
APP_OG_IMAGE_URL=           # absolute URL of a 1200x630 px OG/Twitter preview image (optional)

# Donations (optional)
DONATE_URL=                 # e.g. https://ko-fi.com/<user> — leave blank to hide the
                            # donate button entirely. Verify your platform pays out to
                            # the Dominican Republic; Stripe-backed ones often do not.
